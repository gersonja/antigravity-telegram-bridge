# =============================================================================
# ANTIGRAVITY TELEGRAM MOBILE BRIDGE - CONFIGURACIÓN DE EJEMPLO (.env.example)
# =============================================================================
# Copia este archivo como '.env' en esta misma carpeta y rellena tus credenciales.
# NUNCA subas tu archivo '.env' con credenciales reales al repositorio.

# -----------------------------------------------------------------------------
# 1. SEGURIDAD Y TELEGRAM (OBLIGATORIO)
# -----------------------------------------------------------------------------
# Token oficial proporcionado por @BotFather en Telegram
ANTIGRAVITY_BOT_TOKEN=PEGA_AQUI_TU_TOKEN_DE_BOTFATHER

# Tu ID numérico de Telegram (puedes obtenerlo enviando un mensaje a @userinfobot)
# Solo este usuario tendrá acceso y control sobre la máquina y los repositorios
ANTIGRAVITY_USER_ID=123456789

# -----------------------------------------------------------------------------
# 2. DIRECTORIOS Y REPOSITORIOS
# -----------------------------------------------------------------------------
# Carpetas raíz donde tienes tus repositorios Git (separadas por coma o punto y coma)
ANTIGRAVITY_WORKSPACE_ROOTS=C:\MisProyectos,D:\Proyectos

# Repositorio predeterminado seleccionado al iniciar
ANTIGRAVITY_DEFAULT_PROJECT=C:\MisProyectos\MiApp

# Ruta del archivo para recordar sesión, proyecto y modelo entre reinicios
ANTIGRAVITY_STATE_FILE=bot_state.json

# -----------------------------------------------------------------------------
# 3. MODELO DE IA Y RENDIMIENTO
# -----------------------------------------------------------------------------
# Modelo de IA predeterminado para Antigravity CLI
# Opciones soportadas:
# - gemini-3.8-flash-high (Recomendado)
# - gemini-3.8-flash-medium
# - gemini-3.7-flash-high
# - claude-sonnet-4-6
# - claude-opus-4-6-thinking
# - gpt-oss-120b-medium
ANTIGRAVITY_DEFAULT_MODEL=gemini-3.8-flash-high

# Tiempo máximo de espera para una tarea antes de timeout (segundos)
ANTIGRAVITY_TASK_TIMEOUT=300

# -----------------------------------------------------------------------------
# 4. SWITCHES DE AUTOMATIZACIÓN Y TELEMETRÍA (TURBO DEV)
# -----------------------------------------------------------------------------
# Switch inicial de Turbo AutoPush (true = commit y push automático tras cada cambio)
ANTIGRAVITY_DEFAULT_AUTOPUSH=false

# Watchdog de batería y red eléctrica: alerta ante cortes de luz o desenchufe
ANTIGRAVITY_WATCHDOG_ENABLED=true
ANTIGRAVITY_WATCHDOG_INTERVAL=45

# URL objetivo para el comando /health y botón de prueba web
ANTIGRAVITY_DEFAULT_HEALTH_URL=https://ejemplo.com

